<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="qrschool.Pages.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    Title="Сканирование">

    <Grid RowDefinitions="*,Auto,Auto,Auto" Padding="10">

        <zxing:CameraBarcodeReaderView x:Name="CameraView"
                                       Grid.Row="0"
                                       BarcodesDetected="CameraView_BarcodesDetected"
                                       IsDetecting="True" />

        <Label Grid.Row="1"
               x:Name="CodeLabel"
               Text="Отсканируйте код..."
               HorizontalOptions="Center"
               Margin="0,10,0,0"
               FontAttributes="Bold" />

        <Frame Grid.Row="2" Padding="10" Margin="0,10,0,0">
            <VerticalStackLayout>
                <Label x:Name="TypeLabel" Text="Тип: -" />
                <Label x:Name="RoomLabel" Text="Кабинет: -" />
                <Label x:Name="StatusLabel" Text="Статус: -" />
                <Label x:Name="DescriptionLabel"
                       Text="Описание: -"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="3"
                x:Name="ExportButton"
                Text="Выгрузить в Excel"
                IsEnabled="False"
                Margin="0,10,0,0"
                Clicked="OnExportClicked" />

    </Grid>
</ContentPage>
