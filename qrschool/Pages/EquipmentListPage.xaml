<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="qrschool.Pages.EquipmentListPage"
             Title="Список техники">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="10">
        <Label Text="Добавленная техника"
               FontSize="22"
               FontAttributes="Bold" />

        <HorizontalStackLayout Grid.Row="1" Spacing="10">
            <Button Text="Загрузить из Excel"
                    Clicked="OnImportFromExcelClicked" />

            <Button Text="Выгрузить в Excel"
                    Clicked="OnExportToExcelClicked" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding EquipmentItems}">
            <CollectionView.EmptyView>
                <Label Text="Пока нет добавленной техники"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="Gray" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12"
                           Margin="0,0,0,10"
                           BorderColor="#E0E0E0"
                           CornerRadius="8">
                        <Grid RowDefinitions="Auto,Auto"
                              ColumnDefinitions="*,Auto"
                              RowSpacing="8"
                              ColumnSpacing="8">
                            <VerticalStackLayout Grid.Row="0"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 Spacing="4">
                                <Label Text="{Binding Type}"
                                       FontAttributes="Bold"
                                       FontSize="18" />
                                <Label Text="{Binding InventoryNumber, StringFormat='Инвентарный номер: {0}'}" />
                                <Label Text="{Binding Office, StringFormat='Кабинет: {0}'}" />
                                <Label Text="{Binding Status, StringFormat='Статус: {0}'}" />
                                <Label Text="{Binding Description}"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Row="1"
                                                   Grid.Column="1"
                                                   Spacing="8">
                                <Button Text="Редактировать"
                                        Clicked="OnEditEquipmentClicked"
                                        CommandParameter="{Binding .}" />
                                <Button Text="Удалить"
                                        TextColor="Red"
                                        Clicked="OnDeleteEquipmentClicked"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
