<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:model="clr-namespace:qrschool.Models"
             x:Class="qrschool.Pages.CRUDPage"
             Title="CRUD техники">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Карточка техники" FontAttributes="Bold" FontSize="20" />

            <Picker Title="Тип техники"
                    ItemsSource="{Binding EquipmentTypes}"
                    SelectedItem="{Binding Equipment.Type}" />

            <Picker Title="Кабинет"
                    ItemsSource="{Binding OfficeList}"
                    SelectedItem="{Binding Equipment.Office}" />

            <Picker Title="Статус"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding Equipment.Status}" />

            <Editor Placeholder="Описание"
                    AutoSize="TextChanges"
                    HeightRequest="90"
                    Text="{Binding Equipment.Description}" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="Создать" Command="{Binding SaveCommand}" />
                <Button Grid.Column="1" Text="Обновить" Command="{Binding UpdateCommand}" />
                <Button Grid.Column="2" Text="Удалить" Command="{Binding DeleteCommand}" />
            </Grid>

            <Button Text="Очистить форму" Command="{Binding ClearCommand}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding EquipmentItems}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedEquipment}">
            <CollectionView.EmptyView>
                <Label Text="Записей пока нет" HorizontalTextAlignment="Center" Margin="0,20,0,0" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Equipment">
                    <Frame BorderColor="#DDDDDD" Padding="10" Margin="0,0,0,8">
                        <VerticalStackLayout>
                            <Label Text="{Binding Type}" FontAttributes="Bold" />
                            <Label Text="{Binding Office, StringFormat='Кабинет: {0}'}" />
                            <Label Text="{Binding Status, StringFormat='Статус: {0}'}" />
                            <Label Text="{Binding Description}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
